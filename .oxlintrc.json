{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./packages/config/oxlint/base.json"],
  "options": {
    "typeAware": true
  },
  "ignorePatterns": [
    ".agents/**",
    "packages/api/src/generated/**",
    "**/routeTree.gen.ts",
    "apps/admin/public/mockServiceWorker.js",
    "apps/web/public/mockServiceWorker.js",
    "apps/web/.stackflow-spike-dist/**",
    "**/.expo/**",
    "**/.output/**",
    ".specify/**",
    "**/.turbo/**",
    "**/.wrangler/**",
    "**/coverage/**",
    "**/dist/**",
    "**/storybook-static/**",
    "**/node_modules/**"
  ],
  "overrides": [
    {
      "files": ["apps/web/**/*.{js,jsx,ts,tsx,mjs,cjs}"],
      "plugins": [
        "eslint",
        "typescript",
        "unicorn",
        "oxc",
        "import",
        "promise",
        "react",
        "jsx-a11y",
        "vitest"
      ]
    },
    {
      "files": ["**/*.{spec,test}.{js,jsx,ts,tsx}"],
      "env": {
        "jest": true,
        "vitest": true
      }
    },
    {
      "files": [
        "apps/mobile/app/**/*.{ts,tsx}",
        "apps/storybook/.storybook/**/*.{ts,tsx}",
        "apps/storybook/stories/**/*.stories.{ts,tsx}",
        "**/*.config.{js,ts,mjs,cjs}"
      ],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      "files": ["apps/mobile/app/_layout.tsx"],
      "rules": {
        "eslint/no-console": [
          "warn",
          {
            "allow": ["warn"]
          }
        ]
      }
    }
  ]
}
