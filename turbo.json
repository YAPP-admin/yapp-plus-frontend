{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "mise.toml",
    "mise.lock",
    "pnpm-workspace.yaml",
    ".npmrc",
    "patches/**",
    ".github/workflows/mobile-delivery.yml",
    ".github/workflows/mobile-manual.yml",
    ".github/actions/setup-eas/**"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".output/**", "dist/**", "storybook-static/**"]
    },
    "dev": {
      "cache": false,
      "env": ["MOBILE_WEB_URL", "VITE_API_MOCKING"],
      "persistent": true
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxlintrc.json"],
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "storybook": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    }
  }
}
