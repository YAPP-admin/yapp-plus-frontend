{
  "name": "yapp-plus-frontend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "commitlint": "commitlint",
    "dev": "turbo run dev",
    "expo:doctor": "expo-doctor apps/mobile",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "turbo run lint",
    "prepare": "lefthook install",
    "storybook": "turbo run storybook --filter=@yapp-plus/storybook",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@types/node": "catalog:",
    "expo-doctor": "catalog:",
    "lefthook": "2.1.12",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "turbo": "2.10.12",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24.20.0",
    "pnpm": "12.3.4"
  },
  "packageManager": "pnpm@12.3.4"
}
