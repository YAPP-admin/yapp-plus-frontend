{
  "cli": {
    "version": "27.4.1",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "24.20.0",
      "corepack": false,
      "env": {
        "MOBILE_WEB_URL": "https://yapp-plus-web.vercel.app"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal"
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "testflight": {
      "extends": "base",
      "distribution": "store",
      "autoIncrement": true,
      "channel": "testflight"
    }
  },
  "submit": {
    "testflight": {
      "ios": {
        "ascAppId": "6830536097"
      }
    }
  }
}
