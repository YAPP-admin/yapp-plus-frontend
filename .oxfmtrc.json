{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "endOfLine": "lf",
  "jsxSingleQuote": false,
  "printWidth": 100,
  "semi": true,
  "singleAttributePerLine": false,
  "singleQuote": true,
  "sortPackageJson": true,
  "tabWidth": 2,
  "trailingComma": "all",
  "useTabs": false,
  "ignorePatterns": [
    ".agents/**",
    "pnpm-lock.yaml",
    "mise.lock",
    "**/routeTree.gen.ts",
    "apps/admin/public/mockServiceWorker.js",
    "apps/web/public/mockServiceWorker.js",
    "**/.expo/**",
    "**/.next/**",
    "**/.open-next/**",
    "**/.output/**",
    ".specify/**",
    "**/.turbo/**",
    "**/.wrangler/**",
    "**/coverage/**",
    "**/dist/**",
    "**/storybook-static/**",
    "**/node_modules/**",
    "packages/ui/fonts/pretendardvariable-dynamic-subset.css"
  ]
}
